# Copy to .env and fill in. Doppler users can skip this file entirely.

OPENAI_API_KEY=sk-your-key-here
REDIS_URL=redis://localhost:6379

# Cheap model used to resolve follow-up questions before embedding them.
REWRITE_MODEL=gpt-4o-mini

# Leave false for local use; every limit below is inert until it is true.
# Set it only when exposing the gateway publicly on your own key.
PUBLIC_DEMO=false

# The control that actually protects the budget. Once crossed, upstream calls
# stop and only cache hits are served.
DAILY_BUDGET_USD=5.00

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=600
MAX_OUTPUT_TOKENS=150
MAX_INPUT_CHARS=2000
MAX_MESSAGES=20

# Anything off this list is rejected, so nobody can request a costlier model.
ALLOWED_MODELS=gpt-4o-mini

ENABLE_MODERATION=true
